<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">
        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MC NPU"
            android:textSize="30sp"
            android:textStyle="bold"/>
        <TextView
            android:id="@+id/subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="QNN · Hexagon HTP V73 · 独立加速服务"
            android:textSize="15sp"
            android:layout_marginTop="4dp"/>
        <TextView
            android:id="@+id/npuState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="● NPU 服务状态：检测中"
            android:textSize="18sp"
            android:textStyle="bold"
            android:padding="18dp"
            android:layout_marginTop="24dp"/>
        <Button
            android:id="@+id/start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="启动 / 保持 NPU 服务"
            android:layout_marginTop="12dp"/>
        <Button
            android:id="@+id/test"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="执行 HTP 图测试"
            android:layout_marginTop="8dp"/>
        <TextView
            android:id="@+id/shizukuTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Shizuku 权限"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="28dp"/>
        <TextView
            android:id="@+id/shizukuState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="检测中"
            android:paddingTop="8dp"/>
        <Button
            android:id="@+id/shizukuOpen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="打开 Shizuku"
            android:layout_marginTop="8dp"/>
        <Button
            android:id="@+id/shizukuRequest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="申请 MC NPU 权限"
            android:layout_marginTop="8dp"/>
        <TextView
            android:id="@+id/logTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="诊断日志"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="28dp"/>
        <TextView
            android:id="@+id/log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="等待服务..."
            android:textIsSelectable="true"
            android:fontFamily="monospace"
            android:paddingTop="8dp"/>
    </LinearLayout>
</ScrollView>